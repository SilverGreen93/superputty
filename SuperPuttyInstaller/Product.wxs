<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">  
  <!--
    One source file, two packages, picked by the PerMachine preprocessor variable:

      SuperPuttyInstaller            PerMachine not set -> per-user package   (Scope=perUser)
      SuperPuttyAllUsersInstaller    PerMachine=yes     -> all users package  (Scope=perMachine)

    The per-user package leaves ALLUSERS unset and is not marked Privileged, so Windows
    Installer runs the whole installation in the user's context and UAC never comes up.
    Files go under %LOCALAPPDATA%\Programs\SuperXPuTTY and the Start Menu shortcuts land
    in the user's own menu. A side benefit: SuperXPuTTY then runs unelevated, which is
    what the embedded PuTTY (PuttyEmbed) needs.

    The all users package is marked Privileged, so setup asks for elevation once and the
    files land in %ProgramFiles%\SuperXPuTTY for every account on the machine.

    Everything else is shared, but nothing that belongs to a Windows Installer component
    can sit in the other context, so the two pieces that follow the scope are spelled out
    from preprocessor variables: KeyRoot is the registry root the component key paths use
    (HKCU / HKLM - ICE57 rejects the neutral HKMU in a package with a fixed scope), and
    MenuFolder is the Start Menu location for the shortcuts (ProgramMenuFolder /
    CommonProgramMenuFolder).
    Windows Installer never converts one context into the other, so each package refuses
    to install over the other flavour (see the Launch conditions below): uninstall the
    one you have first, then install the other.
  -->
  <?ifndef PerMachine?>
    <?define PerMachine=no?>
  <?endif?>
  <?if $(var.PerMachine) = yes?>
    <?define InstallScope=perMachine?>
    <?define KeyRoot=HKLM?>
  <?else?>
    <?define InstallScope=perUser?>
    <?define KeyRoot=HKCU?>
  <?endif?>
  <Package Name="SuperXPuTTY" Language="1033" Version="!(bind.fileVersion.ProductExe)" Manufacturer="SilverGreen93" UpgradeCode="03448e74-2381-4de9-93f0-58039c377caa" InstallerVersion="200" Scope="$(var.InstallScope)">
    
    <Icon Id="ProductIcon" SourceFile="$(var.SuperPutty.ProjectDir)Apps-utilities-terminal.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/SilverGreen93/superputty/wiki/Documentation" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/SilverGreen93/superputty/" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!--
      AllowSameVersionUpgrades: Version is bound to SuperXPuTTY.exe's file version, so
      rebuilding or re-releasing without bumping it keeps the same ProductVersion. Windows
      Installer then finds the installed product but no Upgrade rule covers it, and stops
      with "Another version of SuperXPuTTY is already installed" (1638). Including the
      boundary makes the old install a major upgrade instead: it is removed and the new
      package installed. Lower versions still hit the downgrade message below, and WiX
      gives every build a new ProductCode, as a same-version upgrade requires.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- SuperXPuTTY runs on the .NET 10 Desktop Runtime (x64), installed separately -->
    <netfx:DotNetCompatibilityCheck Property="DOTNETDESKTOP10CHECK" RuntimeType="desktop" Platform="x64" Version="10.0.0" RollForward="latestMinor" />
    <Launch Condition="Installed OR DOTNETDESKTOP10CHECK=&quot;0&quot;" Message="[ProductName] requires the .NET 10 Desktop Runtime (x64). Download it from https://dotnet.microsoft.com/download/dotnet/10.0 and run this setup again." />

    <!--
      The "installed" value below is written by the ApplicationShortcuts component, in
      HKCU for the per-user package and HKLM for the all users one. Each flavour searches
      the *other* hive and refuses to run: Windows Installer cannot remove a product
      installed in the other context, so letting this setup through would just leave two
      copies of SuperXPuTTY fighting over the shortcuts.
    -->
    <?if $(var.PerMachine) = yes?>
    <Property Id="PERUSERINSTALL">
      <RegistrySearch Id="FindPerUserInstall" Root="HKCU" Key="Software\SilverGreen93\SuperXPuTTY" Name="installed" Type="raw" />
    </Property>
    <Launch Condition="Installed OR NOT PERUSERINSTALL" Message="SuperXPuTTY is already installed for the current user only ([LocalAppDataFolder]Programs\SuperXPuTTY). Uninstall it from Windows Settings &gt; Apps first, then run this setup again to install it for all users." />
    <?else?>
    <Property Id="MACHINEINSTALL">
      <RegistrySearch Id="FindMachineInstall" Root="HKLM" Key="Software\SilverGreen93\SuperXPuTTY" Name="installed" Type="raw" />
    </Property>
    <Launch Condition="Installed OR NOT MACHINEINSTALL" Message="SuperXPuTTY is already installed for all users ([ProgramFiles64Folder]SuperXPuTTY). Uninstall it from Windows Settings &gt; Apps first, then run this setup again to install it for the current user only." />
    <?endif?>

    <Media Id="1" Cabinet="Cab1.cab" EmbedCab="yes" />
    
    <Feature Id="ProductFeature" Title="SuperXPuTTY" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="DefaultTheme" />
      <ComponentRef Id="ApplicationShortcuts" /> 
    </Feature>

    <WixVariable Id="WixUIBannerBmp" Value="$(var.SolutionDir)SuperPuttyInstaller\WixUIBannerBmp.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.SolutionDir)SuperPuttyInstaller\WixUIDialogBmp.bmp" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.SolutionDir)License.rtf" />

    <!--
      WixUI_Minimal: license page, Verify Ready, progress, finish. No install-folder page,
      because there is no choice to make - each package has one fixed location,
      %LOCALAPPDATA%\Programs\SuperXPuTTY for the per-user setup and
      %ProgramFiles%\SuperXPuTTY for the all users setup. Picking the flavour means picking
      the setup file to run, not answering a page in the wizard.
    -->
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />      
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch SuperXPuTTY" />    
    <Property Id="WixShellExecTarget" Value="[#ProductExe]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_X64" />
  </Package>

  <Fragment>
      <?if $(var.PerMachine) = yes?>
      <!-- %ProgramFiles%\SuperXPuTTY, shared by every account on the machine.
           ProgramFiles64Folder keeps the x64 build out of "Program Files (x86)". -->
      <StandardDirectory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="SuperXPuTTY">
          <Directory Id="INSTALLTHEMEFOLDER" Name="themes">
            <Directory Id="INSTALLDEFAULTTHEME" Name="default">
              <Directory Id="INSTALLTHEMEICONSFOLDER" Name="icons" />
            </Directory>
          </Directory>
        </Directory>
      </StandardDirectory>
      <?else?>
      <!-- %LOCALAPPDATA%\Programs\SuperXPuTTY, the usual spot for per-user Windows apps
           (VS Code and friends). LocalAppDataFolder is a standard directory Windows
           Installer resolves for the current user, so no elevation is needed. -->
      <StandardDirectory Id="LocalAppDataFolder">
        <Directory Id="LocalProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="SuperXPuTTY">
            <Directory Id="INSTALLTHEMEFOLDER" Name="themes">
              <Directory Id="INSTALLDEFAULTTHEME" Name="default">
                <Directory Id="INSTALLTHEMEICONSFOLDER" Name="icons" />
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </StandardDirectory>
      <?endif?>


      <!-- The Start Menu folder the shortcuts go into. In the per-user package that is
           ProgramMenuFolder, which Windows Installer resolves to the current user's menu.
           The all users package cannot use it: WiX reads it as a per-user location (ICE38
           and ICE57 want an HKCU key path there), so the machine package spells out the
           common menu under the shared application data folder instead. Both trees end in
           the same "ProgramMenuSubfolder" directory, so the component below is shared. -->
      <?if $(var.PerMachine) = yes?>
      <StandardDirectory Id="CommonAppDataFolder">
        <Directory Id="CommonMenuMicrosoftFolder" Name="Microsoft">
          <Directory Id="CommonMenuWindowsFolder" Name="Windows">
            <Directory Id="CommonMenuStartFolder" Name="Start Menu">
              <Directory Id="CommonMenuProgramsFolder" Name="Programs">
                <Directory Id="ProgramMenuSubfolder" Name="SuperXPuTTY" />
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </StandardDirectory>
      <?else?>
      <StandardDirectory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuSubfolder" Name="SuperXPuTTY" />
      </StandardDirectory>
      <?endif?>

      <DirectoryRef Id="ProgramMenuSubfolder">
        <Component Id="ApplicationShortcuts" Guid="0CF406F3-901A-4C75-9DCB-BE6042BC70CE">

          <Shortcut Id="ApplicationShortcut1" Name="SuperXPuTTY" Description="SuperXPuTTY Terminal Window Manager" Target="[#ProductExe]" WorkingDirectory="INSTALLFOLDER" />

          <util:InternetShortcut Id="ProjectWebsiteShortcut" Name="Project Website" Target="https://github.com/SilverGreen93/superputty/" />

          <Shortcut Id="UninstallProduct" Name="Uninstall SuperXPuTTY" Target="[SystemFolder]msiexec.exe" Arguments="/x [ProductCode]" Description="Uninstalls SuperXPuTTY" />

          <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="installed" Type="integer" Value="1" KeyPath="yes" />

          <RemoveFolder Id="ProgramMenuSubfolder" On="uninstall" />
        </Component>
      </DirectoryRef>
    </Fragment>

  <Fragment>
    <!--
      Every component here keys off a registry value instead of one of its files: a
      component that installs into the user's profile must not have a file KeyPath (ICE38).
      The values use Root="$(var.KeyRoot)" so they sit in HKCU in the per-user package and
      in HKLM in the all users package, which is what keeps this whole component group
      valid in both flavours. The value is only an install marker, so each file keeps its
      own component and can be repaired on its own. A component with a non-file KeyPath
      cannot have a generated Guid either, so these components spell theirs out.
      The RemoveFolder rows matter most in the profile: Windows Installer does not clean
      directories out of the profile by itself (ICE64), and it only removes a folder once
      it is empty, so %LOCALAPPDATA%\Programs survives if other apps live there.
    -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- .NET 10: SuperXPuTTY.exe is the native launcher, the code is in SuperXPuTTY.dll;
           no ngen (.NET Framework only) -->
      <Component Id="ProductExe" Guid="AD301A84-C006-4797-B0F2-AECEC9E4C754">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.ProductExe" Type="integer" Value="1" KeyPath="yes" />
        <File Id="ProductExe" Source="$(var.SuperPutty.TargetDir)SuperXPuTTY.exe" />
        <?if $(var.PerMachine) != yes?>
        <RemoveFolder Id="RemoveLocalProgramsFolder" Directory="LocalProgramsFolder" On="uninstall" />
        <?endif?>
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
      <Component Id="ProductDll" Guid="BA98487B-6C9E-4FCB-A72F-4C0B5E190F48">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.ProductDll" Type="integer" Value="1" KeyPath="yes" />
        <File Id="ProductDll" Source="$(var.SuperPutty.TargetDir)SuperXPuTTY.dll" />
      </Component>
      <Component Id="ProductDllConfig" Guid="6D2ECE03-59EC-4E97-9C8C-0330636BB595">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.ProductDllConfig" Type="integer" Value="1" KeyPath="yes" />
        <File Id="ProductDllConfig" Source="$(var.SuperPutty.TargetDir)SuperXPuTTY.dll.config" />
      </Component>
      <Component Id="ProductRuntimeConfig" Guid="E3F1EF99-611E-4743-8FE0-2DEEBC88BD59">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.ProductRuntimeConfig" Type="integer" Value="1" KeyPath="yes" />
        <File Id="ProductRuntimeConfig" Source="$(var.SuperPutty.TargetDir)SuperXPuTTY.runtimeconfig.json" />
      </Component>
      <Component Id="ProductDeps" Guid="13E922F8-3CF1-45A6-BD4A-CE11478A135A">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.ProductDeps" Type="integer" Value="1" KeyPath="yes" />
        <File Id="ProductDeps" Source="$(var.SuperPutty.TargetDir)SuperXPuTTY.deps.json" />
      </Component>
      <!-- embedded PuTTY, built by the SuperPutty project from the putty submodule;
           without it SSH/Telnet/Rlogin/Raw/Serial sessions fall back to external PuTTY -->
      <Component Id="ProductPuttyEmbed" Guid="177D2BAE-F891-4918-8078-60132B053F7A">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.PuttyEmbed" Type="integer" Value="1" KeyPath="yes" />
        <File Id="ProductPuttyEmbedDll" Source="$(var.SuperPutty.TargetDir)putty-embed.dll" />
      </Component>
      <Component Id="ProductLibSystemWebAdapters" Guid="C32B1070-51B1-45BD-871C-9BEC9D9AC921">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.SystemWebAdapters" Type="integer" Value="1" KeyPath="yes" />
        <File Id="Microsoft.AspNetCore.SystemWebAdapters.dll" Source="$(var.SuperPutty.TargetDir)Microsoft.AspNetCore.SystemWebAdapters.dll" />
      </Component>
      <Component Id="ProductLibRuntimeCaching" Guid="E2410D98-D7A9-49E1-BCC5-E0E466410F05">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.RuntimeCaching" Type="integer" Value="1" KeyPath="yes" />
        <File Id="System.Runtime.Caching.dll" Source="$(var.SuperPutty.TargetDir)System.Runtime.Caching.dll" />
      </Component>
      <Component Id="ProductLibLogging" Guid="5E31F8FC-BCFA-4288-A70F-ADDCA4552C24">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.log4net" Type="integer" Value="1" KeyPath="yes" />
        <File Id="log4net.dll" Source="$(var.SuperPutty.TargetDir)\log4net.dll" />
      </Component>
      <Component Id="ProductLibUI" Guid="FAC2DC83-26C6-45B2-BFA5-7C9D22CB5F47">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.Docking" Type="integer" Value="1" KeyPath="yes" />
        <File Id="WeifenLuo.WinFormsUI.Docking.dll" Source="$(var.SuperPutty.TargetDir)\WeifenLuo.WinFormsUI.Docking.dll" />
      </Component>
      <Component Id="ProductLibUITheme" Guid="9FC6A351-69DC-4E02-BBE7-600887B3F593">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.DockingTheme" Type="integer" Value="1" KeyPath="yes" />
        <File Id="WeifenLuo.WinFormsUI.Docking.ThemeVS2015.dll" Source="$(var.SuperPutty.TargetDir)\WeifenLuo.WinFormsUI.Docking.ThemeVS2015.dll" />
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="DefaultTheme" Directory="INSTALLTHEMEICONSFOLDER">
      <Component Id="ThemeIconFiles" Guid="E35C914D-0F1B-4F70-B290-4A56CEDBAC57">
        <RegistryValue Root="$(var.KeyRoot)" Key="Software\SilverGreen93\SuperXPuTTY" Name="install.ThemeIcons" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveThemeIconsFolder" Directory="INSTALLTHEMEICONSFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveThemeDefaultFolder" Directory="INSTALLDEFAULTTHEME" On="uninstall" />
        <RemoveFolder Id="RemoveThemeFolder" Directory="INSTALLTHEMEFOLDER" On="uninstall" />
        <File Id="application_osx_terminal.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\application_osx_terminal.png" />
        <File Id="application_xp_terminal.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\application_xp_terminal.png" />
        <File Id="book.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\book.png" />
        <File Id="clock.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\clock.png" />
        <File Id="comment.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\comment.png" />
        <File Id="compress.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\compress.png" />
        <File Id="database.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\database.png" />
        <File Id="drive_network.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\drive_network.png" />
        <File Id="email.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\email.png" />
        <File Id="feed.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\feed.png" />
        <File Id="firewall.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\firewall.png" />
        <File Id="flag_blue.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\flag_blue.png" />
        <File Id="flag_green.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\flag_green.png" />
        <File Id="flag_orange.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\flag_orange.png" />
        <File Id="flag_pink.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\flag_pink.png" />
        <File Id="flag_purple.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\flag_purple.png" />
        <File Id="flag_red.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\flag_red.png" />
        <File Id="flag_yellow.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\flag_yellow.png" />
        <File Id="help.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\help.png" />
        <File Id="house.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\house.png" />
        <File Id="information.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\information.png" />
        <File Id="ipod.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\ipod.png" />
        <File Id="lightbulb.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\lightbulb.png" />
        <File Id="lightning.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\lightning.png" />
        <File Id="lorry.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\lorry.png" />
        <File Id="map.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\map.png" />
        <File Id="monitor.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\monitor.png" />
        <File Id="printer.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\printer.png" />
        <File Id="report.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\report.png" />
        <File Id="server.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\server.png" />
        <File Id="telephone.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\telephone.png" />
        <File Id="television.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\television.png" />
        <File Id="time.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\time.png" />
        <File Id="tux.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\tux.png" />
        <File Id="webcam.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\webcam.png" />
        <File Id="world.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\world.png" />
        <File Id="puffy.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\puffy.png" />
        <File Id="arch_linux.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\arch_linux.png" />
        <File Id="centos.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\centos.png" />
        <File Id="debian.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\debian.png" />
        <File Id="fedora.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\fedora.png" />
        <File Id="freebsd.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\freebsd.png" />
        <File Id="linux_mint.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\linux_mint.png" />
        <File Id="redhat.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\redhat.png" />
        <File Id="suse_linux.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\suse_linux.png" />
        <File Id="ubuntu.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\ubuntu.png" />
        <File Id="windows.png" Source="$(var.SuperPutty.TargetDir)themes\default\icons\windows.png" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>