<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SuperXPuTTY</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>SuperPutty.Program</StartupObject>
    <ApplicationIcon>Apps-utilities-terminal.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- assembly metadata, was SuperPutty/Properties/AssemblyInfo.cs -->
    <Company>SilverGreen93</Company>
    <Product>SuperXPuTTY</Product>
    <Description>PuTTY Window Manager</Description>
    <Copyright>Copyright &#169; 2026 SilverGreen93</Copyright>
    <!-- a single Version drives AssemblyVersion, FileVersion and InformationalVersion.
         AssemblyInfo.cs had a 2.1.1.* wildcard under Debug; 3.0.0.0 is the intended bump. -->
    <Version>3.0.0.0</Version>
    <InformationalVersion>3.0.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- win-x64 only (see RuntimeIdentifier); every .sln configuration maps to x64 -->
    <Platforms>x64</Platforms>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <PackageReference Include="DockPanelSuite" Version="3.1.1" />
    <PackageReference Include="DockPanelSuite.ThemeVS2015" Version="3.1.1" />
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="DarkModeForms\FlatComboBox.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="DarkModeForms\FlatProgressBar.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="DarkModeForms\FlatTabControl.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Gui\QuickSelectorData.cs">
      <DependentUpon>QuickSelectorData.xsd</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="Scp\BrowserView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Scp\FileTransferView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="ctlApplicationPanel.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Gui\QuickSelectorData.xsc">
      <DependentUpon>QuickSelectorData.xsd</DependentUpon>
    </None>
    <None Update="Gui\QuickSelectorData.xsd">
      <SubType>Designer</SubType>
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>QuickSelectorData.Designer.cs</LastGenOutput>
    </None>
    <None Update="Gui\QuickSelectorData.xss">
      <DependentUpon>QuickSelectorData.xsd</DependentUpon>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Apps-utilities-terminal.ico" />
    <Content Include="Resources\accept-gray.png" />
    <Content Include="Resources\application_edit.png" />
    <Content Include="Resources\Apps-terminal.ico" />
    <Content Include="Resources\Apps-utilities-terminal.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources\themes\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>themes\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- embedded PuTTY: putty-embed.dll is built from the putty submodule with CMake
       and must sit next to SuperXPuTTY.exe, see Utils\PuttyEmbed.cs -->
  <PropertyGroup>
    <PuttyDir>$(MSBuildThisFileDirectory)..\putty\</PuttyDir>
    <PuttyBuildDir>$(PuttyDir)build\</PuttyBuildDir>
    <!-- set to false to skip the native build (a putty-embed.dll in the output is then
         simply absent and SSH/Telnet/Rlogin/Raw/Serial fall back to external PuTTY) -->
    <BuildPuttyEmbed Condition=" '$(BuildPuttyEmbed)' == '' ">true</BuildPuttyEmbed>
  </PropertyGroup>
  <Target Name="BuildPuttyEmbed" BeforeTargets="CopyFilesToOutputDirectory"
          Condition=" '$(BuildPuttyEmbed)' == 'true' ">
    <Error Condition="!Exists('$(PuttyDir)CMakeLists.txt')"
           Text="The putty submodule is not checked out; run git submodule update --init to build putty-embed.dll, or build with -p:BuildPuttyEmbed=false" />
    <!-- always run: cmake does its own incrementality, and the copy must still happen
         when only the output folder was cleaned -->
    <!-- first configure: cmake -S . -B build -->
    <Exec Command="cmake -S . -B build" WorkingDirectory="$(PuttyDir)"
          Condition="!Exists('$(PuttyBuildDir)CMakeCache.txt')" />
    <!-- then build that directory, Release config, putty-embed target -->
    <Exec Command="cmake --build build --config Release --target putty-embed" WorkingDirectory="$(PuttyDir)" />
    <!-- the dll lands directly under build\ with the Visual Studio generator and under
         build\windows\ with Ninja/Makefiles, so glob instead of hard-coding one layout -->
    <ItemGroup>
      <PuttyEmbedDll Include="$(PuttyBuildDir)**\putty-embed.dll" />
    </ItemGroup>
    <Error Condition=" '@(PuttyEmbedDll)' == '' "
           Text="cmake built the putty-embed target but no putty-embed.dll was found under $(PuttyBuildDir)" />
    <Copy SourceFiles="@(PuttyEmbedDll)" DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>
</Project>