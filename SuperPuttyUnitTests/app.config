<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>

  <appSettings>
    <!-- for testing -->
    <!-- pscp comes from the putty submodule: initialise the submodule, configure putty with
         cmake, then build the 'pscp' target of the generated putty\build tree in Release.
         The path below is relative to the repository root and is resolved by ScpConfig, so it
         does not depend on where the test host is started from. An absolute path works too.
         tools\scp-test-server.ps1 brings up a server (WSL sshd) that matches the four settings
         below and caches its host key, see the comments in that script. -->
    <add key="SuperPuTTY.ScpTests.PscpLocation" value="putty\build\Release\pscp.exe"/>
    <add key="SuperPuTTY.ScpTests.UserName" value="scptest"/>
    <add key="SuperPuTTY.ScpTests.Password" value="123"/>
    <add key="SuperPuTTY.ScpTests.KnownHost" value="localhost"/>
    <add key="SuperPuTTY.ScpTests.UnKnownHost" value="127.0.0.1"/>
  </appSettings>

  <log4net debug="false">

    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline"/>
      </layout>
    </appender>

    <appender name="DebugAppender" type="log4net.Appender.DebugAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline"/>
      </layout>
    </appender>

    <logger name="SuperPutty.ApplicationPanel">
      <level value="INFO"/>
    </logger>
    <logger name="SuperPutty.SessionTreeview">
      <level value="INFO"/>
    </logger>
    <logger name="SuperPutty.Utils.SimpleMRUTabSwitchStrategy">
      <level value="DEBUG"/>
    </logger>
    <logger name="SuperPutty.RemoteFileListPanel">
      <level value="INFO"/>
    </logger>
    <logger name="SuperPutty.Utils.ChildWindowFocusHelper">
      <level value="INFO"/>
    </logger>
    <logger name="SuperPutty.Scp.BrowserFileInfo">
      <level value="INFO"/>
    </logger>

    <root>
      <level value="DEBUG"/>
      <appender-ref ref="ConsoleAppender"/>
    </root>
  </log4net>

  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
</configuration>
